# ==============================================================================
# LARVAZ HIPHOP — VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a .env.local para configurar tus credenciales de Supabase
# ==============================================================================

# Supabase URL y Anon Key (Obtenidas en app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (OPCIONAL: Solo para tareas administrativas de servidor)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Configuración de URL base de la aplicación (para PWA, metadatos y callbacks de autenticación)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Proveedor de aportes voluntarios (Stripe o MercadoPago - Opcional)
# Si no se configuran, la sección /apoyar-larvaz muestra modo informativo transparente
NEXT_PUBLIC_DONATION_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
